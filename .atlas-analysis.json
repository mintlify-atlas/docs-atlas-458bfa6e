  "keyFeatures": [
    "Linux namespace isolation (mount, PID, network, UTS, IPC, user)",
    "seccomp-bpf system call filtering",
    "Linux capabilities management",
    "Over 1300 pre-built application security profiles",
    "Network sandboxing with virtual interfaces and traffic shaping",
    "Filesystem whitelisting and private directories",
    "AppArmor and SELinux integration",
    "X11 display isolation via Xephyr, Xpra, or Xvfb",
    "DBus sandboxing with fine-grained filtering",
    "Landlock filesystem access control",
    "Desktop integration via firecfg",
    "Sandbox monitoring with firemon"
  ],
  "publicApiSurface": [
